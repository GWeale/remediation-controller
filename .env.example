# Devin API (https://docs.devin.ai/api-reference)
DEVIN_API_KEY=your-devin-api-key
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEVIN_API_BASE=https://api.devin.ai

# Shared secret configured on the GitHub webhook
GITHUB_WEBHOOK_SECRET=choose-a-long-random-string

# Repo + label that trigger remediation runs
TARGET_REPO=GWeale/superset
TRIGGER_LABEL=devin:ready

# Storage / polling
DATABASE_PATH=runs.db
POLL_INTERVAL_SECONDS=30
